import std::printf;

// A generator: its return type is `iter T`, and each `yield` hands the caller
// the next value. Returning (or reaching the end) finishes the iteration.
fn range(start: s32, end: s32) -> iter s32 {
    let i = start;
    loop {
        if (i >= end) {
            return;
        }
        yield i;
        i = i + 1;
    }
}

// Generators can consume other generators
fn evens(limit: s32) -> iter s32 {
    for i in range(0, limit) {
        if (i % 2 == 0) {
            yield i;
        }
    }
}

fn fibonacci() -> iter u64 {
    let a = 0u64;
    let b = 1u64;
    loop {
        yield a;
        let next = a + b;
        a = b;
        b = next;
    }
}

// Iterators are ordinary values: they can be stored, passed and returned
fn first_n(source: iter u64, n: s32) -> iter u64 {
    let count = 0;
    for value in source {
        if (count >= n) {
            break;
        }
        yield value;
        count = count + 1;
    }
}

fn unicode(source: u8[?], len: usize) -> iter u32 {
    let i: usize = 0;

    while (i < len) {
        let a: u32 = source[i];

        if (a < 0x80) {
            yield a;
            i += 1;
            continue;
        }

        let count: usize;
        let cp: u32;
        let lo: u32 = 0x80;   // allowed range for the next continuation byte
        let hi: u32 = 0xBF;

        if (a >= 0xC2 && a <= 0xDF) {
            count = 2;
            cp = a & 0x1F;
        } else if (a >= 0xE0 && a <= 0xEF) {
            count = 3;
            cp = a & 0x0F;
            if (a == 0xE0) { lo = 0xA0; }   // no overlongs
            if (a == 0xED) { hi = 0x9F; }   // no surrogates
        } else if (a >= 0xF0 && a <= 0xF4) {
            count = 4;
            cp = a & 0x07;
            if (a == 0xF0) { lo = 0x90; }   // no overlongs
            if (a == 0xF4) { hi = 0x8F; }   // <= 0x10FFFF
        } else {
            yield 0xFFFD;
            i += 1;
            continue;
        }

        let ok: bool = true;
        let j: usize = 1;

        while (j < count) {
            if (i + j >= len) { ok = false; break; }

            let b: u32 = source[i + j];
            if (b < lo || b > hi) { ok = false; break; }

            lo = 0x80;
            hi = 0xBF;
            cp = (cp << 6) | (b & 0x3F);
            j += 1;
        }

        if (!ok) {
            yield 0xFFFD;
            i += j;      // consume lead + valid continuations, not the offending byte
            continue;
        }

        yield cp;
        i += count;
    }
}

// A container with its own length and accessor functions, for use with the
// four-clause `for`
struct Bytes {
    data: u8[16],
    len: usize,
}

fn bytes_len(bytes: &Bytes) -> usize {
    bytes.len
}

fn bytes_get(bytes: &Bytes, index: usize) -> u8 {
    bytes.data[index]
}

fn main(argc: s32, argv: u8[?][?], envp: u8[?][?]) -> s32 {
    for i in range(0, 5) {
        printf("%d\n", i);
    }

    let numbers: iter s32 = evens(10);
    for n in numbers {
        printf("even: %d\n", n);
    }

    for f in first_n(fibonacci(), 10) {
        printf("fib: %llu\n", f);
    }

    // C-style `for`: init; condition; step
    let squares: u32[5]{0};
    for (let k: usize = 0; k < 5; k++) {
        squares[k] = (k * k) as u32;
    }

    // An optional fourth clause runs before the body on each pass, after the
    // condition has passed
    let bytes = Bytes { data: "minlang bytes!!", len: 15 };
    let total: u32 = 0;
    for (let i: usize = 0; i < bytes_len(&bytes); i++; let byte = bytes_get(&bytes, i)) {
        total += byte;
    }
    printf("byte total: %u\n", total);

    0
}
