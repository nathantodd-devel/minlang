import std::io::printf;

fn main() -> s32 {
    // Signed and unsigned division, remainder and shifts
    let a: u32 = 4000000000;
    let b: s32 = -7;
    printf("%u %d %d\n", a / 3, b / 2, b % 3);
    printf("%d %u\n", b >> 1, a >> 4);

    // Widening keeps the value
    let small: u8 = 200;
    let wide: u32 = small;
    let negative: s8 = -5;
    let wider: s64 = negative;
    printf("%u %lld\n", wide, wider);

    // Arithmetic wraps
    let max: u8 = 255;
    let wrapped: u8 = max + 1;
    printf("%u\n", wrapped);

    // Compound assignment and increments
    let x: u16 = 10;
    x += 5;
    x <<= 2;
    x++;
    x--;
    x--;
    printf("%u\n", x);

    // Comparisons respect signedness
    let big: u32 = 3000000000;
    let ok: bool = big > 5 && b < 0;
    printf("%d\n", ok);
    0
}
