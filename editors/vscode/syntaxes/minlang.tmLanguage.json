{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "minlang",
  "scopeName": "source.minlang",
  "fileTypes": ["pk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#paths" },
    { "include": "#calls" },
    { "include": "#fields" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.minlang",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.minlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.minlang", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.minlang",
          "match": "\\b[0-9]+(\\.[0-9]*([eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)(f32|f64)?|\\b[0-9]+(f32|f64)\\b"
        },
        {
          "name": "constant.numeric.integer.minlang",
          "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|[0-9]+)([us](8|16|32|64))?\\b"
        },
        {
          "name": "constant.language.boolean.minlang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.minlang" },
            "2": { "name": "entity.name.function.minlang" }
          }
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.minlang" },
            "2": { "name": "entity.name.type.minlang" }
          }
        },
        {
          "match": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.minlang" },
            "2": { "name": "variable.other.minlang" }
          }
        },
        {
          "match": "\\b(import)\\b",
          "name": "keyword.control.import.minlang"
        },
        {
          "match": "\\b(pub)\\b",
          "name": "storage.modifier.minlang"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.minlang",
          "match": "\\b(if|else|switch|case|default|while|loop|do|for|in|return|yield|break|continue)\\b"
        },
        {
          "name": "keyword.operator.cast.minlang",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.modifier.iter.minlang",
          "match": "\\biter\\b"
        },
        {
          "name": "variable.language.at.minlang",
          "match": "@"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.minlang",
          "match": "\\b(u8|u16|u32|u64|usize|s8|s16|s32|s64|f32|f64|bool)\\b"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(::)",
          "captures": {
            "1": { "name": "entity.name.namespace.minlang" },
            "2": { "name": "punctuation.separator.namespace.minlang" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(::)([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.minlang" },
            "2": { "name": "punctuation.separator.namespace.minlang" },
            "3": { "name": "variable.other.enummember.minlang" }
          }
        },
        {
          "name": "entity.name.type.minlang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.minlang" }
      }
    },
    "fields": {
      "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "variable.other.property.minlang" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.minlang",
          "match": "<<=|>>=|->|\\+\\+|--|&&|\\|\\||==|!=|<=|>=|<<|>>|[-+*/%&|^]=|[-+*/%&|^!<>=]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.namespace.minlang", "match": "::" },
        { "name": "punctuation.terminator.minlang", "match": ";" },
        { "name": "punctuation.separator.minlang", "match": "[,:.]" },
        { "name": "punctuation.brackets.minlang", "match": "[(){}\\[\\]]" }
      ]
    }
  }
}
